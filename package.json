{
  "name": "stackviz-c",
  "displayName": "Stack Frame Visualizer for C",
  "description": "Compile, auto-step and visualize the call stack of a C program, so that recursion becomes visible.",
  "version": "0.1.0",
  "publisher": "stackviz",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "c",
    "recursion",
    "call stack",
    "gdb",
    "teaching"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:stackviz.compileAndVisualize",
    "onCommand:stackviz.visualizeExistingBinary",
    "onCommand:stackviz.stop",
    "onCommand:stackviz.printCurrentStack",
    "onCommand:stackviz.clear",
    "onCommand:stackviz.openVisualizer",
    "onCommand:stackviz.exportRecording",
    "onCommand:stackviz.importRecording",
    "onCommand:stackviz.checkEnvironment",
    "onCommand:stackviz.openExample",
    "onView:stackviz.callTree"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stackviz.compileAndVisualize",
        "title": "StackViz: Compile and Visualize Recursion",
        "category": "StackViz"
      },
      {
        "command": "stackviz.visualizeExistingBinary",
        "title": "StackViz: Visualize Existing Binary",
        "category": "StackViz"
      },
      {
        "command": "stackviz.stop",
        "title": "StackViz: Stop",
        "category": "StackViz",
        "icon": "$(debug-stop)"
      },
      {
        "command": "stackviz.printCurrentStack",
        "title": "StackViz: Print Current Stack",
        "category": "StackViz",
        "icon": "$(list-ordered)"
      },
      {
        "command": "stackviz.clear",
        "title": "StackViz: Clear",
        "category": "StackViz",
        "icon": "$(clear-all)"
      },
      {
        "command": "stackviz.openVisualizer",
        "title": "StackViz: Open Visualizer",
        "category": "StackViz",
        "icon": "$(open-preview)"
      },
      {
        "command": "stackviz.exportRecording",
        "title": "StackViz: Export Recording",
        "category": "StackViz",
        "icon": "$(export)"
      },
      {
        "command": "stackviz.importRecording",
        "title": "StackViz: Import Recording",
        "category": "StackViz",
        "icon": "$(import)"
      },
      {
        "command": "stackviz.replayPrev",
        "title": "StackViz: Replay: Previous Event",
        "category": "StackViz"
      },
      {
        "command": "stackviz.replayNext",
        "title": "StackViz: Replay: Next Event",
        "category": "StackViz"
      },
      {
        "command": "stackviz.replayNextCall",
        "title": "StackViz: Replay: Next Call",
        "category": "StackViz"
      },
      {
        "command": "stackviz.replayNextReturn",
        "title": "StackViz: Replay: Next Return",
        "category": "StackViz"
      },
      {
        "command": "stackviz.replayFollow",
        "title": "StackViz: Replay: Follow Latest",
        "category": "StackViz"
      },
      {
        "command": "stackviz.checkEnvironment",
        "title": "StackViz: Check Environment",
        "category": "StackViz"
      },
      {
        "command": "stackviz.openExample",
        "title": "StackViz: Open Example",
        "category": "StackViz"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stackviz",
          "title": "StackViz",
          "icon": "media/stackviz.svg"
        }
      ]
    },
    "views": {
      "stackviz": [
        {
          "id": "stackviz.callTree",
          "name": "\u8c03\u7528\u6811",
          "contextualTitle": "StackViz Call Tree",
          "icon": "media/stackviz.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "stackviz.callTree",
        "contents": "\u8fd8\u6ca1\u6709\u8bb0\u5f55\u3002\n[\u7f16\u8bd1\u5e76\u53ef\u89c6\u5316\u9012\u5f52](command:stackviz.compileAndVisualize)\n[\u53ef\u89c6\u5316\u5df2\u6709\u7684\u53ef\u6267\u884c\u6587\u4ef6](command:stackviz.visualizeExistingBinary)\n\u6bcf\u8c03\u7528\u4e00\u6b21\u51fd\u6570\u5c31\u662f\u4e00\u4e2a\u8282\u70b9\uff0c\u6240\u4ee5\u9012\u5f52\u7684\u6bcf\u4e00\u5c42\u90fd\u662f\u72ec\u7acb\u7684\u8282\u70b9\u3002"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stackviz.openVisualizer",
          "when": "view == stackviz.callTree",
          "group": "navigation@0"
        },
        {
          "command": "stackviz.stop",
          "when": "view == stackviz.callTree",
          "group": "navigation@1"
        },
        {
          "command": "stackviz.clear",
          "when": "view == stackviz.callTree",
          "group": "navigation@2"
        },
        {
          "command": "stackviz.printCurrentStack",
          "when": "view == stackviz.callTree",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "stackviz.exportRecording",
          "when": "stackviz.hasRecording"
        },
        {
          "command": "stackviz.replayPrev",
          "when": "stackviz.hasRecording"
        },
        {
          "command": "stackviz.replayNext",
          "when": "stackviz.hasRecording"
        },
        {
          "command": "stackviz.replayNextCall",
          "when": "stackviz.hasRecording"
        },
        {
          "command": "stackviz.replayNextReturn",
          "when": "stackviz.hasRecording"
        },
        {
          "command": "stackviz.replayFollow",
          "when": "stackviz.hasRecording"
        }
      ]
    },
    "configuration": {
      "title": "Stack Frame Visualizer for C",
      "properties": {
        "stackviz.compileMode": {
          "type": "string",
          "enum": [
            "plugin",
            "user",
            "ask"
          ],
          "enumDescriptions": [
            "The extension always compiles the C file with gcc (-g -O0).",
            "The extension never compiles; it runs the executable given by stackviz.binaryPath.",
            "Ask with a QuickPick every time the visualize command runs."
          ],
          "default": "ask",
          "markdownDescription": "How the extension obtains the executable to run. Only relevant for `StackViz: Compile and Visualize Recursion`.",
          "scope": "resource"
        },
        "stackviz.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of an already compiled executable, used when `stackviz.compileMode` is `user` (or picked in `ask` mode). POSIX path.",
          "scope": "resource"
        },
        "stackviz.extraCompilerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments appended to the plugin compile command.",
          "scope": "resource"
        },
        "stackviz.gccPath": {
          "type": "string",
          "default": "gcc",
          "description": "gcc executable used by the plugin compile mode.",
          "scope": "resource"
        },
        "stackviz.gdbPath": {
          "type": "string",
          "default": "gdb",
          "description": "gdb executable used to run and single-step the program.",
          "scope": "resource"
        },
        "stackviz.maxSteps": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum number of single steps recorded in one run.",
          "scope": "resource"
        },
        "stackviz.maxDepth": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum call-stack depth that is tracked and reported.",
          "scope": "resource"
        },
        "stackviz.recordLocals": {
          "type": "boolean",
          "default": true,
          "description": "Read arguments and local variables for the top frame of every step.",
          "scope": "resource"
        },
        "stackviz.maxArrayItems": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Maximum number of array elements shown in a variable preview.",
          "scope": "resource"
        },
        "stackviz.snapshot": {
          "type": "string",
          "enum": [
            "auto",
            "safe"
          ],
          "enumDescriptions": [
            "快速路径：只读栈顶帧，异常时自动回退到完整走栈。默认，1000 层递归约 2 秒。",
            "安全模式：每一步都完整走栈，最慢但完全不依赖捷径，适合程序形状很奇怪时。"
          ],
          "default": "auto",
          "markdownDescription": "gdb 驱动如何判断调用栈的变化。`safe` 会慢几倍，但行为完全可预测。",
          "scope": "resource"
        },
        "stackviz.traceLevel": {
          "type": "string",
          "enum": [
            "all",
            "events",
            "off"
          ],
          "enumDescriptions": [
            "每个事件一行，并在调用/返回时打印完整栈快照（默认）。",
            "每个事件一行，但不打印栈快照，输出量小很多。",
            "只打印开始信息和最后的小结，逐行走交给回放面板。"
          ],
          "default": "all",
          "markdownDescription": "StackViz 输出面板的详细程度。长程序建议用 `events` 或 `off`。",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/run.js test/unit test/integration",
    "test:unit": "npm run compile && node test/run.js test/unit",
    "test:integration": "npm run compile && node test/run.js test/integration",
    "test:slow": "STACKVIZ_SLOW_TESTS=1 node test/run.js test/slow"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "1.85.0",
    "typescript": "^5.4.5"
  }
}
